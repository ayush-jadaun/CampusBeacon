# Backend API URL
# IMPORTANT: The backend uses /api as the base path (NOT /api/v1)
# Routes are like: /api/users/login, /api/users/signup, etc.

# For local development (backend on localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# For Android emulator (backend on host machine)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# For physical device on same network (replace with your computer's IP)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:8000/api

# For production deployment
# EXPO_PUBLIC_API_BASE_URL=https://campusbeacon-backend.onrender.com/api

# Google OAuth Client ID
# Get it from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Supabase Configuration (for real-time chat)
# Get these from your Supabase project settings: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
